    <build>
        <plugins>

            <!-- Папка для помещения в нее jar -->
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${jar.version}</version>
                <configuration>
                    <outputDirectory>${signed.directory}</outputDirectory>
                    <forceCreation>true</forceCreation>
                </configuration>
                <executions>
                    <execution>
                        <id>pack-tls-proxy</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <!-- Используется эта стадия, т.к. при prepare-package samples
                         меняется в .m2 на этот jar, а на момент сборки AndroidTestUtil
                         еще может не быть samples.jar в .m2
                         -->
                        <phase>prepare-package</phase>
                        <configuration>
                            <jarName>tls_proxy</jarName>
                            <skipIfEmpty>true</skipIfEmpty>
                            <!-- опирается на корень samples проекта -->
                            <includes>
                                <include>**/tls_proxy/**</include>
                            </includes>
                            <archive>
                                <addMavenDescriptor>false</addMavenDescriptor>
                                <manifest>
                                    <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                                </manifest>
                                <manifestEntries>
                                    <Build-TimeStamp>${maven.build.timestamp}</Build-TimeStamp>
                                    <Release-Version>${specification.version}.${build.number}</Release-Version>
                                    <Specification-Version>${specification.version}</Specification-Version>
                                    <Implementation-Title>tls_proxy</Implementation-Title>
                                    <Implementation-Version>${build.number}</Implementation-Version>
                                    <Main-Class>tls_proxy.TLSProxy</Main-Class>
                                    <Implementation-Vendor-Id>ru.CryptoPro</Implementation-Vendor-Id>
                                    <Git-Hash>${git.hash}</Git-Hash>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pack-cms-util</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <!-- Используется эта стадия, т.к. при prepare-package samples
                         меняется в .m2 на этот jar, а на момент сборки AndroidTestUtil
                         еще может не быть samples.jar в .m2
                         -->
                        <phase>prepare-package</phase>
                        <configuration>
                            <jarName>cmsutil</jarName>
                            <skipIfEmpty>true</skipIfEmpty>
                            <!-- опирается на корень samples проекта -->
                            <includes>
                                <include>**/cmsutil/**</include>
                            </includes>
                            <archive>
                                <addMavenDescriptor>false</addMavenDescriptor>
                                <manifest>
                                    <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                                </manifest>
                                <manifestEntries>
                                    <Build-TimeStamp>${maven.build.timestamp}</Build-TimeStamp>
                                    <Release-Version>${specification.version}.${build.number}</Release-Version>
                                    <Specification-Version>${specification.version}</Specification-Version>
                                    <Implementation-Title>cmsutil</Implementation-Title>
                                    <Implementation-Version>${build.number}</Implementation-Version>
                                    <Main-Class>cmsutil.CMSMain</Main-Class>
                                    <Implementation-Vendor-Id>ru.CryptoPro</Implementation-Vendor-Id>
                                    <Git-Hash>${git.hash}</Git-Hash>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.version}</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>gost</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>sun</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Инструментирование кода для дальнейшей упаковки в jar и измерения покрытия -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${antrun.version}</version>
                <executions>
                    <execution>
                        <id>cobertura-instrument-classes</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${not.measure.coverage}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${dependency.version}</version>
                <executions>
                    <!-- Зависимости для пользователя google xades -->
                    <execution>
                        <id>copy_xades_for_users</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <inherited>false</inherited>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.googlecode.xades4j</groupId>
                                    <artifactId>xades4j</artifactId>
                                    <version>${xades.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.google.inject.extensions</groupId>
                                    <artifactId>guice-multibindings</artifactId>
                                    <version>2.0</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.google.inject</groupId>
                                    <artifactId>guice</artifactId>
                                    <version>2.0</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>aopalliance</groupId>
                                    <artifactId>aopalliance</artifactId>
                                    <version>1.0</version>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${signed.directory}/${xades.directory}</outputDirectory>
                            <stripVersion>false</stripVersion>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
    <properties>
        <main.basedir>${project.parent.basedir}</main.basedir>
    </properties>
</project>
